{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },

      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },

      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "https+http://auth-service"
          }
        }
      },

      "orders-cluster": {
        "Destinations": {
          "orders-destination": {
            "Address": "https+http://orders-api"
          }
        }
      },

      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "https+http://catalog-api"
          }
        }
      }
    }
  }
}